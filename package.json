{
  "name": "line-country-bot-go",
  "version": "0.1.0",
  "private": true,
  "description": "LINE bot that answers country names with flags and capitals, running on Cloudflare Workers (Go/WebAssembly).",
  "license": "MIT",
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:go": "WASM_BUILD=go bash scripts/build.sh",
    "dev": "wrangler dev",
    "bench:cpu": "node scripts/bench-cpu.mjs",
    "deploy:dry": "wrangler deploy --dry-run --outdir=dist"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  }
}
