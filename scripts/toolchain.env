# Versions and SHA-256 of the official release tarballs used to build the
# wasm with TinyGo. scripts/install-tinygo.sh downloads and verifies them;
# scripts/build.sh checks the TinyGo version. CI uses the hash of this file as
# the cache key for .tools, so changing a value here re-downloads the tools.

TINYGO_VERSION=0.43.0
BINARYEN_VERSION=version_133

# https://github.com/tinygo-org/tinygo/releases/tag/v0.43.0
TINYGO_SHA256_LINUX_AMD64=ca9fc6d055e3889462dea4450a2e42a92242d88b5c362a7ec39bdb563413d78a
TINYGO_SHA256_DARWIN_ARM64=f5e0161f212fb69ad4650a4809e3ca66856e184892e80058f0d47abc64151812

# https://github.com/WebAssembly/binaryen/releases/tag/version_133
BINARYEN_SHA256_LINUX_AMD64=2dc9c7813f5375db93d96ead4b78222fcc3e2677bbb832297af4797782a37489
BINARYEN_SHA256_DARWIN_ARM64=ad66da82ac13f163e424b1643f16c6dfcccc98b5966296b43e52d3cab04f84a8
